<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>TinkerGenie - Leadership Development</title>
    <link rel="manifest" href="manifest.json">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <style>
/* MINIMAL MOBILE FIX - SAFE */
@media (max-width: 768px) {
    .message {
        word-break: break-word !important;
        max-width: calc(100vw - 60px) !important;
    }
    .chat-input {
        position: fixed !important;
        bottom: 0 !important;
        z-index: 1000 !important;
    }
}
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        /* CSS Variables for Theming */
        :root {
            /* Dark Theme (Default) */
            --bg-primary: #0d1117;
            --bg-secondary: #161b22;
            --bg-tertiary: #21262d;
            --border-color: #30363d;
            --text-primary: #e6edf3;
            --text-secondary: #8b949e;
            --text-muted: #57606a;
            --accent-color: #FFD700;
            --accent-hover: #FFA500;
            --danger-color: #f85149;
            --success-color: #3fb950;
            --message-user-bg: #FFD700;
            --message-user-text: #0d1117;
            --message-assistant-bg: #21262d;
            --message-assistant-text: #e6edf3;
            --input-bg: #0d1117;
            --header-bg: #161b22;
            --sidebar-bg: #161b22;
            --modal-bg: #161b22;
            --modal-border: #FFD700;
            /* Settings Modal Dark */
            --settings-header-bg: #21262d;
            --settings-value-bg: #0d1117;
            --hover-bg: #1c2128;
        }
        
        /* Light Theme */
        body.light-theme {
            --bg-primary: #ffffff;
            --bg-secondary: #f6f8fa;
            --bg-tertiary: #e1e4e8;
            --border-color: #d0d7de;
            --text-primary: #24292e;
            --text-secondary: #57606a;
            --text-muted: #6a737d;
            --accent-color: #FFC107;
            --accent-hover: #FFA000;
            --danger-color: #d73a49;
            --success-color: #28a745;
            --message-user-bg: #FFC107;
            --message-user-text: #24292e;
            --message-assistant-bg: #f6f8fa;
            --message-assistant-text: #24292e;
            --input-bg: #ffffff;
            --header-bg: #f6f8fa;
            --sidebar-bg: #f6f8fa;
            --modal-bg: #ffffff;
            --modal-border: #FFC107;
            /* Settings Modal Light */
            --settings-header-bg: #f8f9fa;
            --settings-value-bg: #f8f9fa;
            --hover-bg: #e9ecef;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: var(--bg-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: var(--text-primary);
            position: fixed;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        
        /* Main Layout Container */
        .app-container {
            display: flex;
            height: 100vh;
            width: 100vw;
        }
        
        /* Sidebar */
        .sidebar {
            width: 320px;
            height: 100vh;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }
        
        /* Mobile Sidebar Toggle */
        @media (max-width: 768px) {
            .sidebar {
                position: fixed;
                left: -320px;
                z-index: 999;
                transition: left 0.3s ease;
            }
            
            .sidebar.active {
                left: 0;
            }
            
            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 998;
            }
            
            .sidebar-overlay.active {
                display: block;
            }
        }
        
        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
            background: var(--bg-primary);
        }
        
        .sidebar-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
        }
        
        .sidebar-subtitle {
            font-size: 13px;
            color: var(--text-secondary);
        }
        
        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
        }
        
        .chat-history-item {
            padding: 12px 16px;
            margin-bottom: 4px;
            background: var(--bg-primary);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid transparent;
            position: relative;
        }
        
        .chat-history-item:hover {
            background: var(--bg-secondary);
            border-color: var(--border-color);
        }
        
        .chat-history-item.active {
            background: var(--bg-secondary);
            border-color: var(--accent-color);
        }
        
        .chat-date {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 4px;
        }
        
        .chat-preview {
            font-size: 14px;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .delete-chat-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            opacity: 0;
            transition: all 0.2s;
            padding: 4px;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .chat-history-item:hover .delete-chat-btn {
            opacity: 1;
        }
        
        .delete-chat-btn:hover {
            color: var(--danger-color);
            transform: scale(1.1);
        }
        
        /* Main Chat Container */
        .chat-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }
        
        /* Chat Header */
        .chat-header {
            background: var(--header-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 68px;
            flex-shrink: 0;
        }
        
        .menu-btn {
            display: none;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: background 0.2s;
        }
        
        @media (max-width: 768px) {
            .menu-btn {
                display: block;
            }
        }
        
        .menu-btn:hover {
            background: var(--bg-tertiary);
        }
        
        .menu-btn svg {
            width: 24px;
            height: 24px;
            fill: var(--text-primary);
        }
        
        .chat-header h2 {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .settings-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: all 0.2s;
        }
        
        .settings-btn:hover {
            background: var(--bg-tertiary);
        }
        
        .settings-btn svg {
            width: 24px;
            height: 24px;
            fill: var(--text-secondary);
        }
        
        .settings-btn:hover svg {
            fill: var(--accent-color);
        }
        
        .new-chat-btn {
            background: var(--accent-color);
            border: none;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 8px;
            transition: all 0.2s;
            color: var(--message-user-text);
            font-weight: 600;
            font-size: 14px;
        }
        
        .new-chat-btn:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
        }
        
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: var(--bg-primary);
            -webkit-overflow-scrolling: touch;
        }
        
        /* Message Styles */
        .message {
            margin-bottom: 16px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: messageSlide 0.3s ease-out;
        }
        
        @keyframes messageSlide {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .message.user {
            justify-content: flex-end;
        }
        
        .message.assistant {
            justify-content: flex-start;
        }
        
        .message-content {
            max-width: 70%;
            padding: 12px 16px;
            border-radius: 16px;
            line-height: 1.5;
            position: relative;
        }
        
        .message.user .message-content {
            background: var(--message-user-bg);
            color: var(--message-user-text);
            border-bottom-right-radius: 4px;
        }
        
        .message.assistant .message-content {
            background: var(--message-assistant-bg);
            color: var(--message-assistant-text);
            border-bottom-left-radius: 4px;
        }
        
        /* Chat Input */
        .chat-input {
            background: var(--header-bg);
            border-top: 1px solid var(--border-color);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            height: 76px;
            flex-shrink: 0;
        }
        
        .message-input { color: #FFFFFF !important;
            flex: 1;
            background: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 12px 20px;
            font-size: 15px;
            color: var(--text-primary);
            outline: none;
            transition: border-color 0.2s;
        }
        
        .message-input:focus {
            border-color: var(--accent-color);
        }
        
        .voice-btn, .send-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 10px;
            border-radius: 50%;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .voice-btn svg, .send-btn svg { fill: #8A8A8E !important;
            width: 24px;
            height: 24px;
            fill: var(--text-secondary);
        }
        
        .voice-btn:hover, .send-btn:hover:not(:disabled) {
            background: var(--bg-tertiary);
        }
        
        .voice-btn:hover svg, .send-btn:hover:not(:disabled) svg {
            fill: var(--accent-color);
        }
        
        .send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .voice-btn.recording {
            background: var(--danger-color);
        }
        
        .voice-btn.recording svg {
            fill: white;
        }
        
        /* Typing Indicator */
        .typing-indicator {
            display: none;
            padding: 20px;
            animation: messageSlide 0.3s ease-out;
        }
        
        .typing-indicator.active {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        
        .typing-dot {
            width: 8px;
            height: 8px;
            background: var(--text-secondary);
            border-radius: 50%;
            animation: typingBounce 1.4s infinite ease-in-out;
        }
        
        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }
        
        @keyframes typingBounce {
            0%, 80%, 100% {
                transform: scale(0.8);
                opacity: 0.5;
            }
            40% {
                transform: scale(1);
                opacity: 1;
            }
        }
        
        /* Loading Screen */
        #loadingScreen {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--bg-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }
        
        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid var(--border-color);
            border-top-color: var(--accent-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Scrollbar Styles */
        .chat-messages::-webkit-scrollbar,
        .sidebar-content::-webkit-scrollbar {
            width: 8px;
        }
        
        .chat-messages::-webkit-scrollbar-track,
        .sidebar-content::-webkit-scrollbar-track {
            background: var(--bg-secondary);
        }
        
        .chat-messages::-webkit-scrollbar-thumb,
        .sidebar-content::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }
        
        .chat-messages::-webkit-scrollbar-thumb:hover,
        .sidebar-content::-webkit-scrollbar-thumb:hover {
            background: var(--text-secondary);
        }
        
        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            z-index: 10000;
            align-items: center;
            justify-content: center;
        }
        
        body.light-theme .modal {
            background: rgba(255, 255, 255, 0.95);
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background: var(--modal-bg);
            border: 2px solid var(--modal-border);
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }
        
        .modal-header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .modal-title {
            color: var(--accent-color);
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        
        .modal-subtitle {
            color: var(--text-primary);
            font-size: 20px;
            margin-bottom: 10px;
        }
        
        .modal-description {
            color: var(--text-secondary);
            font-size: 14px;
        }
        
        .modal-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 30px;
        }
        
        .modal-btn {
            padding: 20px 40px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            min-width: 200px;
        }
        
        .modal-btn-primary {
            background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
            color: var(--bg-primary);
        }
        
        .modal-btn-danger {
            background: linear-gradient(135deg, var(--danger-color), #ff6b7a);
            color: white;
        }
        
        .modal-btn-secondary {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }
        
        .modal-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        /* Preferences Options */
        .pref-style-option {
            background: var(--bg-primary);
            border: 2px solid var(--border-color);
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .pref-style-option:hover,
        .pref-style-option.selected {
            border-color: var(--accent-color);
        }
        
        .pref-style-option h4 {
            color: var(--accent-color);
            margin-bottom: 5px;
        }
        
        .pref-style-option p {
            color: var(--text-secondary);
            font-size: 14px;
            margin: 0;
        }
        
        .time-input {
            width: 100%;
            padding: 12px;
            background: var(--input-bg);
            border: 2px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 16px;
        }
        
        /* Professional Settings Modal */
        .settings-popup {
            background: var(--modal-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            animation: slideUp 0.3s ease;
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translate(-50%, -45%);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
        }
        
        .settings-header {
            background: var(--settings-header-bg);
            padding: 20px 24px;
            border-bottom: 1px solid var(--border-color);
            border-radius: 16px 16px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .settings-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .settings-title svg {
            width: 24px;
            height: 24px;
            fill: var(--accent-color);
        }
        
        .settings-close-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            transition: background 0.2s;
        }
        
        .settings-close-btn:hover {
            background: var(--hover-bg);
        }
        
        .settings-close-btn svg {
            width: 24px;
            height: 24px;
            fill: var(--text-secondary);
        }
        
        .settings-close-btn:hover svg {
            fill: var(--text-primary);
        }
        
        .settings-body {
            padding: 24px;
        }
        
        .setting-group {
            margin-bottom: 24px;
        }
        
        .setting-group:last-child {
            margin-bottom: 0;
        }
        
        .setting-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        
        .setting-value-box {
            background: var(--settings-value-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 12px 16px;
            color: var(--text-primary);
            font-size: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
            cursor: pointer;
        }
        
        .setting-value-box:hover {
            border-color: var(--accent-color);
            background: var(--modal-bg);
            box-shadow: 0 2px 8px rgba(255, 193, 7, 0.15);
        }
        
        .setting-value-text {
            font-weight: 500;
            color: var(--text-primary);
        }
        
        .setting-value-box svg {
            width: 16px;
            height: 16px;
            fill: var(--text-secondary);
        }
        
        .progress-indicator {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        
        .settings-divider {
            height: 1px;
            background: var(--border-color);
            margin: 0 24px;
        }
        
        .settings-footer {
            padding: 24px;
        }
        
        .logout-btn {
            background: #dc3545;
            color: white;
            border: none;
            padding: 14px 24px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .logout-btn:hover {
            background: #c82333;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
        }
        
        .logout-btn:active {
            transform: translateY(0);
        }
        
        .logout-btn svg {
            width: 18px;
            height: 18px;
            fill: white;
        }
        
        .theme-toggle {
            display: flex;
            gap: 10px;
            padding: 4px;
            background: var(--bg-primary);
            border-radius: 10px;
        }
        
        .theme-option {
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--text-secondary);
        }
        
        .theme-option.active {
            background: var(--accent-color);
            color: var(--bg-primary);
        }
        
        .progress-container {
            background: var(--bg-primary);
            border-radius: 8px;
            height: 8px;
            overflow: hidden;
            margin-top: 8px;
        }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-color), var(--accent-hover));
            transition: width 0.3s;
        }
        /* Send Button UX States */
        .send-btn.active {
            background: #FFD700 !important;
            color: #000 !important;
        }
        .voice-btn.active {
            background: #FFD700 !important;
            color: #000 !important;
        }
        /* NATIVE CHAT APP STYLING */
        .chat-messages {
            padding: 16px 12px 120px 12px !important;
            background: #f8f9fa !important;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        }

        /* Modern Message Bubbles */
        .message {
            margin-bottom: 12px !important;
            display: -webkit-box !important; display: -moz-box !important; display: -ms-flexbox !important; display: -webkit-flex !important; display: flex !important;
            max-width: 85% !important;
            clear: both !important;
        }

        /* User Messages (Right Aligned) */
        .message.user {
            margin-left: auto !important;
            justify-content: flex-end !important;
        }

        .message.user .message-content {
            background: #FFD700 !important;
            color: #333 !important;
            border-radius: 18px 18px 4px 18px !important; -webkit-border-radius: 18px 18px 4px 18px !important;
            padding: 12px 16px !important;
            font-size: 16px !important;
            line-height: 1.4 !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1) !important; -webkit-box-shadow: 0 1px 2px rgba(0,0,0,0.1) !important; -moz-box-shadow: 0 1px 2px rgba(0,0,0,0.1) !important;
        }

        /* Assistant Messages (Left Aligned) */
        .message.assistant {
            margin-right: auto !important;
            justify-content: flex-start !important;
        }

        .message.assistant .message-content {
            background: #E5E5EA !important;
            color: #333 !important;
            border-radius: 18px 18px 18px 4px !important; -webkit-border-radius: 18px 18px 18px 4px !important;
            padding: 12px 16px !important;
