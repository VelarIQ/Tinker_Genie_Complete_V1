    <script>
        // Initialize the app when page loads
        let app;
        let isRecording = false;
        let recognition = null;
        let selectedPrefStyle = 'balanced';
        
        // Theme Management
        function initTheme() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            setTheme(savedTheme);
        }
        
        function setTheme(theme) {
            if (theme === 'light') {
                document.body.classList.add('light-theme');
                document.getElementById('lightTheme')?.classList.add('active');
                document.getElementById('darkTheme')?.classList.remove('active');
                document.getElementById('themeText').textContent = 'Light Mode';
            } else {
                document.body.classList.remove('light-theme');
                document.getElementById('darkTheme')?.classList.add('active');
                document.getElementById('lightTheme')?.classList.remove('active');
                document.getElementById('themeText').textContent = 'Dark Mode';
            }
            localStorage.setItem('theme', theme);
        }
        
        function toggleTheme() {
            const currentTheme = localStorage.getItem('theme') || 'dark';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            setTheme(newTheme);
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize theme
            initTheme();
            
            // Check authentication BEFORE creating app
            const authToken = localStorage.getItem('authToken');
            const userId = localStorage.getItem('userId');
            
            if (!authToken || !userId) {
                console.log('No authentication found, redirecting to login');
                window.location.href = 'login.html';
                return;
            }
            
            try {
                app = new TinkerGenieApp();
                
                // Initialize the app
                if (app && app.authenticated) {
                    app.init();
                    
                    // Check if first time user or URL parameter
                    const userId = localStorage.getItem('userId');
                    const hasCompletedOnboarding = localStorage.getItem(`onboardingCompleted_${userId}`) === 'true';
                    const urlParams = new URLSearchParams(window.location.search);
                    
                    if (!hasCompletedOnboarding || urlParams.get('showPreferences') === 'true') {
                        // Show preferences modal for first-time setup
                        showPreferencesModal();
                        // Clear the URL parameter
                        if (urlParams.get('showPreferences') === 'true') {
                            window.history.replaceState({}, document.title, window.location.pathname);
                        }
                    } else {
                        // Show welcome modal on every visit
                        showWelcomeModal();
                    }
                    
                    // Setup speech recognition
                    setupSpeechRecognition();
                } else {
                    // App created but not authenticated, redirect to login
                    console.log('App not authenticated, redirecting to login');
                    window.location.href = 'login.html';
                }
            } catch (error) {
                console.error('Failed to initialize app:', error);
                // Always redirect to login on any error
                console.log('Initialization error, redirecting to login');
                window.location.href = 'login.html';
            }
        });
        
        // Global functions for onclick handlers
        function sendMessageClick() {
            if (app && app.sendMessage) {
                app.sendMessage();
            }
        }
        
        async function startNewChat() {
            try {
                if (!app || !app.authToken) {
                    console.log('No authentication, redirecting to login');
                    window.location.href = 'login.html';
                    return;
                }
                
                const response = await fetch('/api/chat/new', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${app.authToken}`
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    
                    // Clear current chat
                    const container = document.getElementById('chatMessages');
                    if (container) {
                        container.innerHTML = '';
                    }
                    
                    // Reset conversation state
                    app.state.conversationId = data.conversationId;
                    localStorage.setItem(`conversation_${app.state.userId}`, data.conversationId);
                    
                    // Show welcome message
                    if (data.message) {
                        app.addMessage(data.message, 'assistant');
                    }
                    
                    // Refresh sidebar
                    setTimeout(() => app.loadSidebarConversations(), 500);
                    
                    console.log('New chat started successfully');
                } else {
                    console.error('Failed to start new chat:', response.status);
                    app.addMessage('Sorry, I couldn\'t start a new chat. Please try again.', 'assistant');
                }
            } catch (error) {
                console.error('Error starting new chat:', error);
                app.addMessage('Sorry, there was an error starting a new chat.', 'assistant');
            }
        }
        
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            sidebar.classList.toggle('active');
            overlay.classList.toggle('active');
        }
        
        function toggleDictation() {
            if (!recognition) {
                setupSpeechRecognition();
            }
            
            if (recognition) {
                if (isRecording) {
                    recognition.stop();
                } else {
                    recognition.start();
                }
            }
        }
        
        function setupSpeechRecognition() {
            if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                recognition = new SpeechRecognition();
                recognition.continuous = false;
                recognition.interimResults = false;
                recognition.lang = 'en-US';
                
                recognition.onstart = () => {
                    isRecording = true;
                    document.getElementById('voice-button')?.classList.add('recording');
                };
                
                recognition.onend = () => {
                    isRecording = false;
                    document.getElementById('voice-button')?.classList.remove('recording');
                };
                
                recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    const input = document.getElementById('message-input');
                    if (input) {
                        input.value = transcript;
                        document.getElementById('send-button').disabled = false;
                    }
                };
                
                recognition.onerror = (event) => {
                    console.error('Speech recognition error:', event.error);
                    isRecording = false;
                    document.getElementById('voice-button')?.classList.remove('recording');
                };
            }
        }
        
        // Welcome Modal Functions
        function showWelcomeModal() {
            const userName = localStorage.getItem('userName') || 'User';
            const scheduledTime = localStorage.getItem('scheduledTime') || '09:00';
            
            // Get time-based greeting
            const currentHour = new Date().getHours();
            let greeting;
            if (currentHour < 12) {
                greeting = 'Good Morning';
            } else if (currentHour < 18) {
                greeting = 'Good Afternoon';
            } else {
                greeting = 'Good Evening';
            }
            
            document.getElementById('timeGreeting').textContent = greeting;
            document.getElementById('modalUserName').textContent = userName;
            document.getElementById('modalDayNumber').textContent = app.state.currentDay;
            document.getElementById('modalDayText').textContent = app.state.currentDay;
            
            // Format scheduled time
            const [hours, minutes] = scheduledTime.split(':');
            const h = parseInt(hours);
            const ampm = h >= 12 ? 'PM' : 'AM';
            const displayHours = h > 12 ? h - 12 : (h === 0 ? 12 : h);
            document.getElementById('modalScheduledTime').textContent = `${displayHours}:${minutes} ${ampm}`;
            
            document.getElementById('welcomeModal').classList.add('active');
        }
        
        function closeWelcomeModal() {
            document.getElementById('welcomeModal').classList.remove('active');
        }
        
        function startDailyPromptFromModal() {
            closeWelcomeModal();
            if (app && app.startDailyPrompt) {
                app.startDailyPrompt();
            }
        }
        
        function startBurningFiresFromModal() {
            closeWelcomeModal();
            if (app && app.startBurningFires) {
                app.startBurningFires();
            }
        }
        
        // Preferences Modal Functions
        function showPreferencesModal() {
            const userName = localStorage.getItem('userName') || 'User';
            document.getElementById('prefUserName').textContent = userName;
            
            // Get time-based greeting for preferences too
            const currentHour = new Date().getHours();
            let greeting;
            if (currentHour < 12) {
                greeting = 'Good Morning';
            } else if (currentHour < 18) {
                greeting = 'Good Afternoon';
            } else {
                greeting = 'Good Evening';
            }
            
            // Update the time-based greeting
            const greetingElement = document.getElementById('prefTimeGreeting');
            if (greetingElement) {
                greetingElement.textContent = greeting;
            }
            
            document.getElementById('preferencesModal').classList.add('active');
        }
        
        function selectPrefStyle(style, element) {
            selectedPrefStyle = style;
            
            // Reset all style options to default
            document.querySelectorAll('.pref-style-choice').forEach(option => {
                option.style.background = '#f7f8fa';
                option.style.border = '2px solid #e5e7eb';
                option.style.transform = 'translateX(0)';
                option.style.boxShadow = 'none';
                
                // Reset text colors
                const title = option.querySelector('h3');
                const desc = option.querySelector('p');
                if (title) title.style.color = '#1a1a1a';
                if (desc) desc.style.color = '#6b7280';
            });
            
            // Apply selected style
            if (element) {
                element.style.background = 'linear-gradient(135deg, #FFD700 0%, #FFA500 100%)';
                element.style.border = '2px solid #FFD700';
                element.style.transform = 'translateX(4px)';
                element.style.boxShadow = '0 4px 20px rgba(255, 215, 0, 0.3)';
                
                // Update text colors for selected
                const title = element.querySelector('h3');
                const desc = element.querySelector('p');
                if (title) title.style.color = '#1a1a1a';
                if (desc) desc.style.color = '#1a1a1a';
            }
        }
        
        function skipPreferences() {
            // Set default preferences
            selectedPrefStyle = 'balanced';
            const promptTime = '09:00';
            
            const userId = localStorage.getItem('userId');
            localStorage.setItem(`onboardingCompleted_${userId}`, 'true');
            localStorage.setItem('scheduledTime', promptTime);
            
            document.getElementById('preferencesModal').classList.remove('active');
            showWelcomeModal();
        }
        
        async function savePreferences() {
            const userId = localStorage.getItem('userId');
            const authToken = localStorage.getItem('authToken');
            const promptTime = document.getElementById('prefPromptTime').value;
            
            if (!userId || !authToken) {
                console.error('Missing user credentials');
                alert('Please log in again to save preferences.');
                return;
            }
            
            console.log('Saving preferences for user:', userId);
            console.log('Style:', selectedPrefStyle, 'Time:', promptTime);
            
            try {
                const response = await fetch('/api/preferences/' + userId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${authToken}`
                    },
                    body: JSON.stringify({
                        communicationStyle: selectedPrefStyle,
                        promptTime: promptTime,
                        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'America/New_York'
                    })
                });
                
                const responseText = await response.text();
                console.log('Response status:', response.status);
                console.log('Response:', responseText);
                
                if (response.ok) {
                    localStorage.setItem(`onboardingCompleted_${userId}`, 'true');
                    localStorage.setItem('scheduledTime', promptTime);
                    localStorage.setItem('communicationStyle', selectedPrefStyle);
                    
                    document.getElementById('preferencesModal').classList.remove('active');
                    showWelcomeModal();
                } else {
                    let errorMessage = 'Failed to save preferences.';
                    try {
                        const errorData = JSON.parse(responseText);
                        if (errorData.error) {
                            errorMessage = errorData.error;
                        }
                    } catch (e) {
                        // Response wasn't JSON
                    }
                    console.error('Failed to save preferences:', errorMessage);
                    alert(errorMessage + ' Please try again.');
                }
            } catch (error) {
                console.error('Error saving preferences:', error);
                alert('Network error. Please check your connection and try again.');
            }
        }
        
        // Settings Modal Functions
        let settingsData = {
            communicationStyle: 'balanced',
            dailyPromptTime: '09:00',
            timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone
        };
        
        function openSettingsModal() {
            document.getElementById('settingsModal').classList.add('active');
            loadSettingsModal();
        }
        
        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.remove('active');
        }
        
        async function loadSettingsModal() {
            const userId = localStorage.getItem('userId');
            const authToken = localStorage.getItem('authToken');
            
            if (!userId || !authToken) return;
            
            try {
                const response = await fetch(`/api/preferences/${userId}`, {
                    headers: {
                        'Authorization': `Bearer ${authToken}`
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    settingsData.communicationStyle = data.communicationStyle || 'balanced';
                    settingsData.dailyPromptTime = data.promptTime || data.dailyPromptTime || '09:00';
                    settingsData.timeZone = data.timezone || data.timeZone || settingsData.timeZone;
                    
                    // Update UI
                    const styleMap = {
                        'concise': 'Concise',
                        'balanced': 'Balanced',
                        'detailed': 'Detailed'
                    };
                    document.getElementById('responseStyleText').textContent = styleMap[settingsData.communicationStyle] || 'Balanced';
                    
                    // Update time zone
                    const timeZone = settingsData.timeZone || 'America/New_York';
                    const timeZoneDisplay = timeZone.replace('_', ' ').replace('/', ' - ');
                    document.getElementById('timeZoneText').textContent = timeZoneDisplay;
                    
                    // Format time
                    const [hours, minutes] = settingsData.dailyPromptTime.split(':');
                    const h = parseInt(hours);
                    const ampm = h >= 12 ? 'PM' : 'AM';
                    const displayHours = h > 12 ? h - 12 : (h === 0 ? 12 : h);
                    document.getElementById('promptTimeText').textContent = `${displayHours}:${minutes} ${ampm}`;
                    
                    // Update progress
                    const currentDay = parseInt(localStorage.getItem(`currentDay_${userId}`) || '1');
                    document.getElementById('progressText').textContent = `Day ${currentDay} of 180`;
                    const progressPercentage = (currentDay / 180) * 100;
                    document.getElementById('progressBar').style.width = `${progressPercentage}%`;
                }
            } catch (error) {
                console.error('Failed to load settings:', error);
            }
        }
        
        async function saveSettingsToServer() {
            const userId = localStorage.getItem('userId');
            const authToken = localStorage.getItem('authToken');
            
            if (!userId || !authToken) return;
            
            try {
                await fetch(`/api/preferences/${userId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${authToken}`
                    },
                    body: JSON.stringify({
                        communicationStyle: settingsData.communicationStyle,
                        promptTime: settingsData.dailyPromptTime,
                        timezone: settingsData.timeZone
                    })
                });
                
                localStorage.setItem('scheduledTime', settingsData.dailyPromptTime);
            } catch (error) {
                console.error('Failed to save settings:', error);
            }
        }
        
        function toggleResponseStyle() {
            const styles = ['concise', 'balanced', 'detailed'];
            const styleMap = {
                'concise': 'Concise',
                'balanced': 'Balanced',
                'detailed': 'Detailed'
            };
            const currentIndex = styles.indexOf(settingsData.communicationStyle);
            const nextIndex = (currentIndex + 1) % styles.length;
            settingsData.communicationStyle = styles[nextIndex];
            document.getElementById('responseStyleText').textContent = styleMap[settingsData.communicationStyle];
            saveSettingsToServer();
        }
        
        function togglePromptTime() {
            const modal = document.createElement('div');
            modal.innerHTML = `
                <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 10001; display: flex; align-items: center; justify-content: center;">
                    <div style="background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; width: 300px;">
                        <h3 style="color: var(--text-primary); margin-bottom: 16px;">Set Daily Prompt Time</h3>
                        <input type="time" id="timePickerInput" value="${settingsData.dailyPromptTime}" style="
                            width: 100%;
                            padding: 12px;
                            background: var(--input-bg);
                            border: 1px solid var(--border-color);
                            border-radius: 8px;
                            color: var(--text-primary);
                            font-size: 16px;
                        ">
                        <div style="display: flex; gap: 12px; margin-top: 20px;">
                            <button onclick="cancelTimePicker()" style="
                                flex: 1;
                                padding: 12px;
                                background: transparent;
                                border: 1px solid var(--border-color);
                                border-radius: 8px;
                                color: var(--text-primary);
                                cursor: pointer;
                            ">Cancel</button></div>
                            <button onclick="saveTimePicker()" style="
                                flex: 1;
                                padding: 12px;
                                background: var(--accent-color);
                                border: none;
                                border-radius: 8px;
                                color: var(--bg-primary);
                                font-weight: 600;
                                cursor: pointer;
                            ">Save</button></div>
                        </div>
                    </div>
                </div>
            `;
            modal.id = 'timePickerModal';
            document.body.appendChild(modal);
        }
        
        function cancelTimePicker() {
            const modal = document.getElementById('timePickerModal');
            if (modal) modal.remove();
        }
        
        function saveTimePicker() {
            const input = document.getElementById('timePickerInput');
            if (input) {
                settingsData.dailyPromptTime = input.value;
                const [hours, minutes] = settingsData.dailyPromptTime.split(':');
                const h = parseInt(hours);
                const ampm = h >= 12 ? 'PM' : 'AM';
                const displayHours = h > 12 ? h - 12 : (h === 0 ? 12 : h);
                document.getElementById('promptTimeText').textContent = `${displayHours}:${minutes} ${ampm}`;
                saveSettingsToServer();
            }
            cancelTimePicker();
        }
        
        function logout() {
            if (confirm('Are you sure you want to sign out?')) {
                localStorage.clear();
                window.location.href = 'login.html';
            }
        }
        
        // Close sidebar when clicking overlay
        document.getElementById('sidebarOverlay').addEventListener('click', function() {
            toggleSidebar();
        });
        
        // Add keyboard shortcut for send (Ctrl/Cmd + Enter)
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                sendMessageClick();
            }
        });
    </script>
</body>
