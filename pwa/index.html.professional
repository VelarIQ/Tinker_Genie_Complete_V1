                    Save Settings
                </button>
            </div>
        </div>
    </div><!-- Main Settings Sections -->
            <div class="settings-main">
                <!-- Communication Style Section -->
                <div class="settings-section">
                    <h3>Communication Style</h3>
                    <div class="style-options">
                        <div class="style-option" id="settingsConcise" onclick="selectStyle('concise')">
                            <div class="style-icon">🎯</div>
                            <div class="style-content">
                                <h4>Concise</h4>
                                <p>Direct, actionable insights</p>
                            </div>
                        </div>
                        <div class="style-option" id="settingsBalanced" onclick="selectStyle('balanced')">
                            <div class="style-icon">⚖️</div>
                            <div class="style-content">
                                <h4>Balanced</h4>
                                <p>Perfect mix of detail and clarity</p>
                            </div>
                        </div>
                        <div class="style-option" id="settingsDetailed" onclick="selectStyle('detailed')">
                            <div class="style-icon">📚</div>
                            <div class="style-content">
                                <h4>Detailed</h4>
                                <p>In-depth explanations with examples</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Daily Prompt Time Section -->
                <div class="settings-section">
                    <h3>Daily Prompt Time</h3>
                    <div class="time-picker">
                        <div class="time-input-container" id="settingsTimeInputContainer">
                            <input type="time" id="settingsPromptTime" class="time-input" value="09:00" placeholder="Select time" aria-describedby="settings-timezone-help">
                        </div>
                        <p id="settings-timezone-help">This will be in your local timezone</p>
                    </div>
                </div>
                
                <!-- Theme Section -->
                <div class="settings-section">
                    <h3>Theme</h3>
                    <div class="style-options">
                        <div class="theme-option style-option" data-theme="light" onclick="selectTheme('light')">
                            <div class="style-icon">☀️</div>
                            <div class="style-info">
                                <h4>Light Mode</h4>
                                <p>Clean and bright interface</p>
                            </div>
                        </div>
                        <div class="theme-option style-option" data-theme="dark" onclick="selectTheme('dark')">
                            <div class="style-icon">🌙</div>
                            <div class="style-info">
                                <h4>Dark Mode</h4>
                                <p>Easy on the eyes</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Theme Section -->
                <div class="settings-section">
                    <h3>Theme</h3>
                    <div class="theme-options">
                        <div class="theme-option" id="settingsLightTheme" onclick="selectTheme('light')">
                            <div class="theme-icon">☀️</div>
                            <div class="theme-content">
                                <h4>Light Mode</h4>
                                <p>Clean and bright interface</p>
                            </div>
                        </div>
                        <div class="theme-option" id="settingsDarkTheme" onclick="selectTheme('dark')">
                            <div class="theme-icon">🌙</div>
                            <div class="theme-content">
