                <form id="loginForm">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" placeholder="Enter username" value="admin" autocomplete="username" aria-describedby="username-help">
                </div>

                <div class="form-group">
