<script>
// Theme Management
function initTheme() {
    const savedTheme = localStorage.getItem('theme') || 'light';
    applyTheme(savedTheme);
}

function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    document.body.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    
    // Update theme selector if settings are open
    if (document.getElementById('settings')?.style.display === 'flex') {
        document.querySelectorAll('.theme-option').forEach(option => {
            option.classList.remove('selected');
        });
        document.querySelector(`.theme-option[data-theme="${theme}"]`)?.classList.add('selected');
    }
}

function selectTheme(theme) {
    applyTheme(theme);
    document.querySelectorAll('.theme-option').forEach(option => {
        option.classList.remove('selected');
    });
    document.querySelector(`.theme-option[data-theme="${theme}"]`)?.classList.add('selected');
    
    // Store for saving
    window.tempSelectedTheme = theme;
}

// Auto-scroll functionality
function scrollToBottom(smooth = true) {
    const messagesContainer = document.getElementById('messagesContainer') || 
                            document.querySelector('.chat-messages');
    
    if (messagesContainer) {
        if (smooth) {
            messagesContainer.scrollTo({
                top: messagesContainer.scrollHeight,
                behavior: 'smooth'
            });
        } else {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    }
}

// Ensure auto-scroll on new messages
function ensureAutoScroll() {
    const messagesContainer = document.getElementById('messagesContainer') || 
                            document.querySelector('.chat-messages');
    
    if (messagesContainer) {
        // Watch for new messages
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.addedNodes.length > 0) {
                    // Check if any added node is a message
                    for (let node of mutation.addedNodes) {
                        if (node.classList && (node.classList.contains('message') || 
                            node.classList.contains('user-message') || 
                            node.classList.contains('assistant-message'))) {
                            setTimeout(() => scrollToBottom(true), 100);
                            break;
                        }
                    }
                }
            });
        });
        
        observer.observe(messagesContainer, {
            childList: true,
            subtree: true
        });
    }
}

// Update openSettings to include theme
const originalOpenSettings = window.openSettings;
window.openSettings = function() {
    const currentTheme = localStorage.getItem('theme') || 'light';
    
    // Call original if exists
    if (originalOpenSettings) {
        originalOpenSettings();
    }
    
    // Set theme selector
    document.querySelectorAll('.theme-option').forEach(option => {
        option.classList.remove('selected');
    });
    document.querySelector(`.theme-option[data-theme="${currentTheme}"]`)?.classList.add('selected');
}

// Update saveSettings to include theme
const originalSaveSettings = window.saveSettings;
window.saveSettings = async function() {
    const theme = window.tempSelectedTheme || localStorage.getItem('theme') || 'light';
    localStorage.setItem('theme', theme);
    applyTheme(theme);
    
    // Call original save if exists
    if (originalSaveSettings) {
        await originalSaveSettings();
    } else {
        // Default save behavior
        const style = window.tempSelectedStyle || localStorage.getItem('communicationStyle') || 'balanced';
        const promptTime = document.getElementById('settingsPromptTime').value;
        
        localStorage.setItem('communicationStyle', style);
        localStorage.setItem('promptTime', promptTime);
        
        showNotification('Settings saved successfully!', 'success');
        closeSettings();
    }
}

// Initialize on load
document.addEventListener('DOMContentLoaded', function() {
    initTheme();
    ensureAutoScroll();
    setTimeout(() => scrollToBottom(false), 500);
});

// Also handle if already loaded
if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initTheme();
    ensureAutoScroll();
}
</script>
<script>
// Enhanced auto-scroll for chat
(function() {
    // Override the addMessage function to include auto-scroll
    const originalAddMessage = window.TinkerGenieChatbot?.prototype?.addMessage;
    if (originalAddMessage) {
        window.TinkerGenieChatbot.prototype.addMessage = function(message, isUser) {
            originalAddMessage.call(this, message, isUser);
            setTimeout(() => {
                const container = document.getElementById('messagesContainer');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            }, 100);
        };
    }
    
    // Also handle renderAssistant function
    const originalRenderAssistant = window.renderAssistant;
    if (originalRenderAssistant) {
        window.renderAssistant = function(message) {
            originalRenderAssistant(message);
            setTimeout(() => {
                const container = document.getElementById('messagesContainer');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            }, 100);
        };
    }
    
    // Handle sendMessage to scroll after user message
    const originalSendMessage = window.sendMessage;
    if (originalSendMessage) {
        window.sendMessage = async function() {
            await originalSendMessage();
            setTimeout(() => {
                const container = document.getElementById('messagesContainer');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            }, 100);
        };
    }
})();
</script>
