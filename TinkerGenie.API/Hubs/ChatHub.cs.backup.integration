using Microsoft.AspNetCore.SignalR;
using Microsoft.AspNetCore.Authorization;
using System.Text.Json;
using System.Collections.Concurrent;

namespace TinkerGenie.API.Hubs
{
    [Authorize]
    public class ChatHub : Hub
    {
        private readonly ILogger<ChatHub> _logger;
        private readonly IHttpClientFactory _httpClientFactory;
        private readonly string _openAiApiKey;
        private readonly string _openAiModel;
        
        // Store conversation histories in memory (keyed by conversationId)
        private static readonly ConcurrentDictionary<string, List<object>> _conversationHistories = new();
        
        // Maximum messages to keep in history (to avoid token limits)
        private const int MaxHistoryMessages = 20;

        public ChatHub(ILogger<ChatHub> logger, IConfiguration configuration, IHttpClientFactory httpClientFactory)
        {
            _logger = logger;
            _httpClientFactory = httpClientFactory;
            _openAiApiKey = Environment.GetEnvironmentVariable("OPENAI_API_KEY") ?? configuration["OpenAI:ApiKey"] ?? "";
            _openAiModel = configuration["OpenAI:Model"] ?? "gpt-4o-mini";
        }

        public async Task SendMessage(string message, string? conversationId = null)
        {
            try
            {
                _logger.LogInformation("WebSocket message received: {Message}", message);
                
                // Get user ID from connection context
                var userId = Context.User?.Identity?.Name ?? "anonymous";
                
                // Generate conversation ID if not provided
                conversationId ??= Guid.NewGuid().ToString();
                
                // Show typing indicator
                await Clients.Caller.SendAsync("ReceiveTypingIndicator", true);
                
                // Get AI response with conversation history
                var aiResponse = await GetAIResponseWithHistory(message, userId, conversationId);
                
                // Hide typing indicator
                await Clients.Caller.SendAsync("ReceiveTypingIndicator", false);
                
                // Send response
                await Clients.Caller.SendAsync("ReceiveMessage", new
                {
                    type = "ReceiveMessage",
                    message = aiResponse,
                    conversationId = conversationId,
                    timestamp = DateTime.UtcNow,
                    isError = false
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error in SendMessage: {ErrorMessage}", ex.Message);
                
                var errorResponse = new
                {
                    type = "ReceiveMessage",
                    message = "I'm experiencing some technical difficulties, but I'm still here to help with your leadership journey. What would you like to discuss today?",
                    conversationId = conversationId,
                    timestamp = DateTime.UtcNow,
                    isError = true
                };
                
                await Clients.Caller.SendAsync("ReceiveMessage", errorResponse);
            }
        }

        public async Task SendDailyPromptRequest()
        {
            try
            {
                _logger.LogInformation("Daily prompt request received");
                
                var userId = Context.User?.Identity?.Name ?? "anonymous";
                var currentDay = 1; // This should be retrieved from database
                
                var dailyPrompt = await GetDailyPrompt(currentDay, userId);
                
                await Clients.Caller.SendAsync("ReceiveMessage", new
                {
                    type = "ReceiveMessage",
                    message = dailyPrompt,
                    conversationId = (string?)null,
                    isError = false,
                    isDailyPrompt = true,
                    dayNumber = currentDay,
                    questionsRemaining = 3,
                    timestamp = DateTime.UtcNow
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error in SendDailyPromptRequest: {ErrorMessage}", ex.Message);
            }
        }

        private async Task<string> GetAIResponseWithHistory(string userMessage, string userId, string conversationId)
        {
            try
            {
                _logger.LogInformation("Starting WebSocket OpenAI API request with conversation history");
                
                // Get or create conversation history
                var history = _conversationHistories.GetOrAdd(conversationId, _ => new List<object>());
                
                // Build messages array with history
                var messages = new List<object>();
                
                // Add system prompt
                var systemPrompt = await BuildSystemPrompt(userId);
                messages.Add(new { role = "system", content = systemPrompt });
                
                // Add conversation history
                lock (history)
                {
                    messages.AddRange(history);
                    
                    // Add current user message
                    var userMsg = new { role = "user", content = userMessage };
                    messages.Add(userMsg);
                    history.Add(userMsg);
                    
                    // Trim history if too long
                    while (history.Count > MaxHistoryMessages)
                    {
                        history.RemoveAt(0);
                    }
                }
                
                var request = new
                {
                    model = _openAiModel,
                    messages = messages,
                    max_tokens = 500,
                    temperature = 0.7,
                    top_p = 1.0,
                    frequency_penalty = 0,
                    presence_penalty = 0
                };

                var json = JsonSerializer.Serialize(request);
                _logger.LogInformation("Sending request with {MessageCount} messages in conversation history", messages.Count);
                
                var httpClient = _httpClientFactory.CreateClient();
                httpClient.DefaultRequestHeaders.Add("Authorization", $"Bearer {_openAiApiKey}");
                
                var response = await httpClient.PostAsync(
                    "https://api.openai.com/v1/chat/completions",
                    new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
                
                var responseContent = await response.Content.ReadAsStringAsync();
                _logger.LogInformation("WebSocket OpenAI API response status: {StatusCode}", response.StatusCode);
                
                if (!response.IsSuccessStatusCode)
                {
                    _logger.LogError("WebSocket OpenAI API error: {ResponseContent}", responseContent);
                    return "I'm experiencing some technical difficulties, but I'm still here to help with your leadership journey. What would you like to discuss today?";
                }
                
                var responseJson = JsonSerializer.Deserialize<JsonElement>(responseContent);
                var aiMessage = responseJson.GetProperty("choices")[0].GetProperty("message").GetProperty("content").GetString();
                
                // Add AI response to history
                lock (history)
                {
                    history.Add(new { role = "assistant", content = aiMessage });
                }
                
                return aiMessage ?? "I'm here to help with your leadership journey. What would you like to discuss?";
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error getting AI response: {ErrorMessage}", ex.Message);
                return "I'm experiencing some technical difficulties, but I'm still here to help with your leadership journey. What would you like to discuss today?";
            }
        }

        // Keep the old GetAIResponse for backward compatibility, but redirect to new method
        private async Task<string> GetAIResponse(string userMessage, string userId)
        {
            return await GetAIResponseWithHistory(userMessage, userId, Guid.NewGuid().ToString());
        }

        private async Task<string> BuildSystemPrompt(string userId)
        {
            var prompt = new System.Text.StringBuilder();
            
            // Enhanced system prompt with better context
            prompt.AppendLine("You are TinkerGenie, an advanced AI leadership coach and mentor created by Chris Cooper of Two-Brain Business.");
            prompt.AppendLine("You provide direct, actionable leadership guidance - concise, impactful, and focused on results.");
            prompt.AppendLine();
            prompt.AppendLine("IMPORTANT: You have access to the full conversation history. Reference previous messages when relevant.");
            prompt.AppendLine("Build upon earlier topics and maintain context throughout the conversation.");
            prompt.AppendLine();
            prompt.AppendLine("Key principles:");
            prompt.AppendLine("- Be direct and concise (2-3 sentences max per response)");
            prompt.AppendLine("- Ask one tough question that makes them think");
            prompt.AppendLine("- Focus on action and results");
            prompt.AppendLine("- Use professional, human tone");
            prompt.AppendLine("- Remember and reference previous discussion points");
            prompt.AppendLine("- Build on their answers to go deeper");
            prompt.AppendLine("- Address burning fires with urgency");
            
            return prompt.ToString();
        }

        private async Task<string> BuildAIPrompt(string userMessage, string userId)
        {
            // This method is kept for backward compatibility
            return await BuildSystemPrompt(userId);
        }

        public Task Ping()
        {
            return Task.CompletedTask;
        }

        private async Task<string> GetDailyPrompt(int dayNumber, string userId)
        {
            var prompts = new Dictionary<int, string>
            {
                { 1, "Day 1 - Vision Check\nWhat's the ONE thing that, if achieved this quarter, would make everything else easier or unnecessary?" },
                { 2, "Day 2 - Time Audit\nTrack your time today in 30-minute blocks. Where are you investing vs. spending time?" },
                { 3, "Day 3 - Communication Check\nBefore your next important conversation, ask: 'What do I really want them to understand?' Then communicate that clearly." }
            };

            return prompts.GetValueOrDefault(dayNumber, "Today's reflection: What leadership challenge are you facing right now?");
        }
    }
}
