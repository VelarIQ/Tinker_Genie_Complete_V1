        private bool IsBurningFiresScenario(string message)
        {
            var lowerMessage = message?.ToLower() ?? "";
            
            // First check for explicit "burning fires" mention
            if (lowerMessage.Contains("burning fire") || lowerMessage.Contains("burning fires"))
            {
                return true;
            }
            
            // Only trigger on truly urgent patterns with multiple indicators
            var urgentPatterns = new[]
            {
                "emergency", "crisis", "urgent help", "immediate", "asap",
                "critical situation", "disaster", "falling apart"
            };
            
            var stressIndicators = new[]
            {
                "overwhelmed", "drowning", "can't handle", "losing control",
                "about to quit", "walking out", "threatening to leave"
            };
            
            // Count how many urgent indicators are present
            var urgentCount = urgentPatterns.Count(pattern => lowerMessage.Contains(pattern));
            var stressCount = stressIndicators.Count(pattern => lowerMessage.Contains(pattern));
            
            // Only trigger if we have strong signals (at least 2 indicators)
            return (urgentCount + stressCount) >= 2;
        }

        private async Task<string> BuildDailyPromptAIPrompt(string userMessage, DailyPromptSession session, string userId)
        {
            // Get user's communication style preference
            var userStyle = await GetUserCommunicationStyle(userId);
            
            var prompt = new StringBuilder();
            
            prompt.AppendLine("You are Chris Cooper, founder of Two-Brain Business. You're having a mentoring conversation");
            prompt.AppendLine("with a business owner about their daily leadership reflection. Be their mentor, not their friend.");
            prompt.AppendLine("Guide them to insights, don't just validate their feelings.");
            prompt.AppendLine("IMPORTANT: They may run any type of business - don't assume it's a gym or fitness business.");
            prompt.AppendLine("NEVER give out personal contact information, email addresses, or phone numbers.");
            prompt.AppendLine();
            
            prompt.AppendLine("CONTEXT:");
            prompt.AppendLine($"• Day {session.DayNumber} reflection topic: {session.DailyPrompt}");
            prompt.AppendLine($"• Their response: \"{userMessage}\"");
            
            // Add conversation history for context
            if (session.ConversationHistory != null && session.ConversationHistory.Any())
            {
                prompt.AppendLine("• Previous conversation in this session:");
                foreach (var msg in session.ConversationHistory.TakeLast(3))
                {
                    prompt.AppendLine($"  - {msg}");
                }
            }
            
            prompt.AppendLine();
            prompt.AppendLine("HOW TO RESPOND AS A MENTOR:");
            prompt.AppendLine("• ACKNOWLEDGE what they've shared - show you heard them");
            prompt.AppendLine("• CHALLENGE their thinking - don't just agree");
            prompt.AppendLine("• CONNECT it to leadership principles");
            prompt.AppendLine("• PROVIDE insight they hadn't considered");
            prompt.AppendLine("• Reference EXACTLY what they said - use their words");
            prompt.AppendLine();
            
            prompt.AppendLine("FORMATTING RULES (APA Style):");
            prompt.AppendLine("• Use bullet points (•) for lists of 3 or more items");
            prompt.AppendLine("• Numbers (1., 2., 3.) for sequential steps only");
            prompt.AppendLine("• Define acronyms on first use");
            prompt.AppendLine("• Proper capitalization for business terms");
            prompt.AppendLine();
            
            prompt.AppendLine("IMPORTANT - DO NOT:");
            prompt.AppendLine("• Do NOT ask follow-up questions");
            prompt.AppendLine("• Do NOT prompt for more information");
            prompt.AppendLine("• Do NOT say 'tell me more' or similar");
            prompt.AppendLine("• This is acknowledgment and insight, not interrogation");
            prompt.AppendLine();
            
            prompt.AppendLine("LENGTH:");
            
            // Adjust response length based on user's communication style
            if (userStyle == "concise")
            {
                prompt.AppendLine("• ULTRA CONCISE: 2-3 sentences maximum");
                prompt.AppendLine("• One key insight, that's it");
                prompt.AppendLine("• Example: 'That's leadership growth. Keep pushing through.'");
            }
            else if (userStyle == "detailed")
            {
                prompt.AppendLine("• Provide a thorough response - 6-8 sentences");
                prompt.AppendLine("• Include context and deeper meaning");
                prompt.AppendLine("• Share what this means for their leadership journey");
            }
            else // balanced
            {
                prompt.AppendLine("• Keep it to 3-5 sentences");
                prompt.AppendLine("• Balance acknowledgment with insight");
                prompt.AppendLine("• Focus on what matters most");
            }
            
            prompt.AppendLine();
            prompt.AppendLine("MENTORING TONE:");
            prompt.AppendLine("• You're their guide, not their cheerleader");
            prompt.AppendLine("• Be warm but professional");
            prompt.AppendLine("• Challenge them to grow");
            prompt.AppendLine("• Share wisdom from experience");
            prompt.AppendLine();
            prompt.AppendLine("Respond as Chris Cooper the mentor would:");

            return prompt.ToString();
        }

